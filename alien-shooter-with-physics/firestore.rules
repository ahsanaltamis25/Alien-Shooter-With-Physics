rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStudent(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60 &&
        (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 40)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 30)) &&
        (!('highScore' in data) || (data.highScore is number)) &&
        (!('questionsCorrect' in data) || (data.questionsCorrect is number)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidGameSave(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.level is number && data.level >= 1 &&
        data.score is number && data.score >= 0 &&
        data.health is number && data.health >= 0 &&
        (!('maxHealth' in data) || (data.maxHealth is number)) &&
        (!('ammo' in data) || (data.ammo is number)) &&
        (!('aliensDefeated' in data) || (data.aliensDefeated is number)) &&
        (!('questionsAnswered' in data) || (data.questionsAnswered is number)) &&
        (!('savedAt' in data) || (data.savedAt is string && data.savedAt.size() <= 50));
    }

    function isValidLeaderboard(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60 &&
        data.highScore is number && data.highScore >= 0 &&
        (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 40)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 30)) &&
        (!('questionsCorrect' in data) || (data.questionsCorrect is number)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId && isValidStudent(request.resource.data);
      allow update: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId && isValidStudent(request.resource.data);
      allow delete: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId;
    }

    match /saves/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId && isValidGameSave(request.resource.data);
      allow update: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId && isValidGameSave(request.resource.data);
      allow delete: if isSignedIn() && isValidId(studentId) && request.auth.uid == studentId;
    }

    match /leaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId) && request.auth.uid == entryId && isValidLeaderboard(request.resource.data);
      allow update: if isSignedIn() && isValidId(entryId) && request.auth.uid == entryId && isValidLeaderboard(request.resource.data);
      allow delete: if isSignedIn() && isValidId(entryId) && request.auth.uid == entryId;
    }
  }
}
